{
  "$schema": "https://oxc.rs/schemas/oxlintrc.json",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".agentic-browser/**",
    ".llm-browser/**",
    ".codex/**",
    "coverage/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "no-underscore-dangle": "off"
  }
}
