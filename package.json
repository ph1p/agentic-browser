{
  "name": "agentic-browser",
  "version": "0.1.0",
  "description": "CLI and MCP server for AI agents to control Chrome via CDP",
  "keywords": [
    "agent",
    "ai",
    "automation",
    "browser",
    "cdp",
    "chrome",
    "devtools-protocol",
    "llm",
    "mcp"
  ],
  "homepage": "https://ph1p.github.io/agentic-browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ph1p/agentic-browser.git"
  },
  "bin": {
    "agentic-browser": "dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "extension",
    "AGENTS.md",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.mts",
      "default": "./dist/cli/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.mts",
      "default": "./dist/mcp/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "docs:build": "vocs build",
    "docs:dev": "vocs dev",
    "docs:preview": "vocs preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint -c .oxlintrc.json --fix .",
    "prepublishOnly": "pnpm build && pnpm test",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vocs": "2.6.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1"
}
